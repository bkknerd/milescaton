{#- expects: ytId, ytList, ytTitle, ytSub, ytC, ytC2 -#}
<div class="yt" data-yt="{{ ytId }}" data-list="{{ ytList }}" data-title="{{ ytTitle }}" style="--tc:{{ ytC or '#a3170b' }};--tc2:{{ ytC2 or '#f0a23a' }}">
  <div class="tint"></div><div class="lines"></div><div class="vig"></div>
  <button class="yt-play" type="button" data-cursor="Play" aria-label="Play {{ ytTitle }}">
    <span class="yt-t">{{ ytTitle }}</span>{% if ytSub %}<span class="yt-s">{{ ytSub }}</span>{% endif %}
    <span class="play" aria-hidden="true"><svg viewBox="0 0 20 24"><path d="M0 0 L20 12 L0 24 Z"/></svg></span>
  </button>
  <a class="yt-out sm" href="{% if ytList %}https://www.youtube.com/playlist?list={{ ytList }}{% else %}https://www.youtube.com/watch?v={{ ytId }}{% endif %}" target="_blank" rel="noopener">YouTube ↗<span class="vh"> (opens in a new tab)</span></a>
</div>
