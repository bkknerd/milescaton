---
layout: layouts/base.njk
title: The story
permalink: /story/
pageKey: story
theme: black
computed:
  description: "{{ story.seo_description }}"
next: { url: "/sinners/", title: "Sinners", italic: "", aside: "" }
---
<section class="phead" data-theme="black">
  <div class="kick sm"><span>The story</span><span>{{ story.entries[0].year }}–{{ (story.entries | last).year }}</span></div>
  <h1 class="phead-t hd-hand">{{ story.title }} <span class="it" data-erode>{{ story.italic }}</span></h1>
  <p class="phead-p">{{ story.intro }}</p>
</section>
<section class="hs" id="record" data-theme="black" aria-label="Timeline">
  <div class="hs-head sm" aria-hidden="true"><span>Timeline</span><span class="hs-hint">Scroll <span class="ar" aria-hidden="true">→</span></span></div>
  <div class="track" id="track">
    <div class="pnl intro">
      <h2 class="hd-hand">{{ story.opener.headline }} <span class="it" data-erode>{{ story.opener.italic }}</span></h2>
      <p>{{ story.opener.text }}</p>
    </div>
    {%- for e in story.entries %}
    <article class="pnl{% if e.key %} key{% endif %}{% if e.image %} has-pic{% endif %}">
      {% if e.age %}<span class="age sm">{{ e.age }}</span>{% endif %}
      <div class="yr" aria-hidden="true">{{ e.year }}</div>
      {% if e.image %}<figure class="pfig">{% img e.image, e.alt, "", "(max-width: 820px) 84vw, 30vw" %}{% if e.caption %}<figcaption class="sm">{{ e.caption }}</figcaption>{% endif %}</figure>{% endif %}
      <div class="txt"><h3><span class="vh">{{ e.year }}: </span>{{ e.title | mdi | safe }}</h3><p>{{ e.body }}</p></div>
    </article>
    {%- endfor %}
  </div>
  <div class="hs-bar" aria-hidden="true"><i id="hsbar"></i></div>
</section>
