<a class="next" href="{{ next.url }}" data-cursor="Next">
  <span class="kick sm"><span>Next chapter</span><span>{{ next.aside or "Keep going" }}</span></span>
  <span class="next-t"><span class="next-a">{{ next.title }}</span>{% if next.italic %} <span class="next-b">{{ next.italic }}</span>{% endif %}<span class="next-arrow" aria-hidden="true">→</span></span>
</a>
